{
  "schemaVersion": "1.0",
  "id": "msp-account-management-report",
  "name": "MSP Account Management Report",
  "version": "0.1.0",
  "description": "Generates account-management reporting for MSP customer review workflows, starting with Microsoft 365 license summary data.",
  "repository": "https://github.com/W0rmsp17/MSPAccountManagementReport",
  "image": "ghcr.io/w0rmsp17/mspaccountmanagementreport/msp-account-management-report:0.1.0",
  "runtime": "container-apps-job",
  "entrypoint": [
    "dotnet",
    "MSPAccountManagementReport.dll"
  ],
  "timeoutSeconds": 900,
  "concurrency": 1,
  "costTier": "Low",
  "approvalRequired": false,
  "executionContract": {
    "input": {
      "schema": "module.input.schema.json",
      "type": "json",
      "sources": [
        {
          "name": "CONTROL_PLANE_JOB_INPUT_BASE64",
          "type": "environment"
        },
        {
          "name": "argument[0]",
          "type": "filePath"
        }
      ]
    },
    "output": {
      "type": "json",
      "destinations": [
        {
          "name": "CONTROL_PLANE_OUTPUT_BLOB_URI",
          "type": "blobSasUri"
        },
        {
          "name": "CONTROL_PLANE_OUTPUT_PATH",
          "type": "filePath"
        }
      ]
    },
    "environment": [
      {
        "name": "GRAPH_ACCESS_TOKEN",
        "required": false,
        "description": "Microsoft Graph bearer token supplied by the control plane for live collection. Local sample data is used when omitted."
      }
    ]
  },
  "supportedScopes": [
    "Tenant",
    "Users"
  ],
  "parametersSchema": {
    "type": "object",
    "properties": {
      "includeInactiveUsers": {
        "type": "boolean",
        "default": false
      },
      "includeLicenseWaste": {
        "type": "boolean",
        "default": true
      },
      "reportFormat": {
        "type": "string",
        "enum": [
          "json",
          "html",
          "markdown"
        ],
        "default": "json"
      }
    },
    "required": []
  },
  "requiredPermissions": [
    {
      "provider": "MicrosoftGraph",
      "permission": "Organization.Read.All",
      "type": "Application",
      "reason": "Reads tenant organization metadata and subscribed SKU information for account-management reporting."
    },
    {
      "provider": "MicrosoftGraph",
      "permission": "User.Read.All",
      "type": "Application",
      "reason": "Reads user profile and assigned license data to identify licensed, unlicensed, and disabled licensed accounts."
    },
    {
      "provider": "MicrosoftGraph",
      "permission": "Directory.Read.All",
      "type": "Application",
      "reason": "Provides directory read coverage for tenant-level reporting where user and license relationships require directory context."
    }
  ],
  "outputsSchema": {
    "schema": "module.output.schema.json",
    "type": "object",
    "required": [
      "status",
      "summary",
      "findings",
      "metrics",
      "report"
    ]
  },
  "artifacts": {
    "structuredJson": true,
    "renderedFormats": [
      "markdown"
    ]
  }
}
