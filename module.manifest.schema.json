{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/W0rmsp17/MSPAccountManagementReport/module.manifest.schema.json",
  "title": "MSP Automation Control Plane Module Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "repository",
    "image",
    "runtime",
    "entrypoint",
    "dataHandling",
    "timeoutSeconds",
    "concurrency",
    "costTier",
    "executionContract",
    "supportedScopes",
    "parametersSchema",
    "requiredPermissions",
    "outputsSchema",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "enum": [
        "container-apps-job"
      ]
    },
    "entrypoint": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "costTier": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ]
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "dataHandling": {
      "type": "object",
      "required": [
        "classification",
        "containsPersonalData",
        "containsSecrets",
        "retentionRecommendationDays",
        "artifactSensitivity"
      ],
      "properties": {
        "classification": {
          "type": "string"
        },
        "containsPersonalData": {
          "type": "boolean"
        },
        "containsSecrets": {
          "type": "boolean"
        },
        "retentionRecommendationDays": {
          "type": "integer",
          "minimum": 1
        },
        "artifactSensitivity": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "executionContract": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "object",
          "required": [
            "type",
            "sources"
          ]
        },
        "output": {
          "type": "object",
          "required": [
            "type",
            "destinations"
          ]
        },
        "environment": {
          "type": "array"
        }
      }
    },
    "supportedScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Tenant",
          "Users",
          "Groups"
        ]
      }
    },
    "parametersSchema": {
      "type": "object"
    },
    "requiredPermissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "permission",
          "type"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "permission": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Application",
              "Delegated"
            ]
          }
        }
      }
    },
    "outputsSchema": {
      "type": "object"
    },
    "artifacts": {
      "type": "object"
    }
  }
}
